_schema-version: "3.2"
ID: DevolucionesDev-extension
extends: Devoluciones

parameters:
  appname: devoluciones-dev
  subdomain: ${org}

modules:
  - name: devoluciones-approuter
    parameters:
      memory: 256M
      disk-quota: 256M
      routes:
        - route: https://${subdomain}-${appname}.${default-domain}

resources:
  - name: uaa_Devoluciones
    parameters:
      service-name: ${appname}-xsuaa
      config:
        xsappname: ${appname}

  - name: Devoluciones_saas_registry
    parameters:
      service-name: ${appname}-saas-registry
      config:
        xsappname: ${appname}
        appName: ${appname}
        displayName: Devoluciones Dev
        description: Aplicacion Devoluciones - Ambiente Dev

  - name: AppsPortalFront-destination-service
    parameters:
      service-name: AppsPortalFront-dev-destination

  - name: Devoluciones_html_repo_host
    parameters:
      service-name: Devoluciones-Dev-html5-host

  - name: AppsPortalFront_html_repo_runtime
    parameters:
      service-name: AppsPortalFront-dev-html5-runtime