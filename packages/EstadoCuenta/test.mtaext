_schema-version: "3.2"
ID: EstadoCuentaTest-extension
extends: EstadoCuenta

parameters:
  appname: estadocuenta-test
  subdomain: ${org}

modules:
  - name: estadocuenta-approuter
    parameters:
      memory: 256M
      disk-quota: 256M
      routes:
        - route: https://${subdomain}-${appname}.${default-domain}

resources:

  - name: uaa_EstadoCuenta
    parameters:
      service-name: ${appname}-xsuaa
      config:
        xsappname: ${appname}

  - name: EstadoCuenta_saas_registry
    parameters:
      service-name: ${appname}-saas-registry
      config:
        xsappname: ${appname}
        appName: ${appname}
        displayName: Estado de Cuenta Test
        description: Aplicación Estado de Cuenta - Ambiente Test

  - name: AppsPortalFront-destination-service
    parameters:
      service-name: AppsPortalFront-test-destination

  - name: EstadoCuenta_html_repo_host
    parameters:
      service-name: EstadoCuenta-Test-html5-host

  - name: AppsPortalFront_html_repo_runtime
    parameters:
      service-name: AppsPortalFront-test-html5-runtime