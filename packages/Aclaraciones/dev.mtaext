_schema-version: "3.2"
ID: AclaracionesDev-extension
extends: Aclaraciones

parameters:
  appname: aclaraciones-dev
  subdomain: ${org}

modules:
  - name: aclaraciones-approuter
    parameters:
      memory: 256M
      disk-quota: 256M
      routes:
        - route: https://${subdomain}-${appname}.${default-domain}

resources:

  - name: uaa_Aclaraciones
    parameters:
      service-name: ${appname}-xsuaa
      config:
        xsappname: ${appname}

  - name: Aclaraciones_saas_registry
    parameters:
      service-name: ${appname}-saas-registry
      config:
        xsappname: ${appname}
        appName: ${appname}
        displayName: Aclaraciones Dev
        description: Aplicacion Aclaraciones - Ambiente Dev

  - name: AppsPortalFront-destination-service
    parameters:
      service-name: AppsPortalFront-dev-destination

  - name: Aclaraciones_html_repo_host
    parameters:
      service-name: Aclaraciones-Dev-html5-host

  - name: AppsPortalFront_html_repo_runtime
    parameters:
      service-name: AppsPortalFront-dev-html5-runtime