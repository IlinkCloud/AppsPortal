                        rows="{obtenAcla>/results}"
                        selectionMode="Single"
                        selectionBehavior="RowSelector"
                        alternateRowColors="true"
                        enableColumnReordering="true"
                        enableBusyIndicator="true"
                        enableSelectAll="false"
                        noData="{i18n>clarifications.without}"
                        rowSelectionChange="onRowSelectionChangeAcla"
                    >
                        <t:rowMode>
                            <rowmodes:Interactive rowCount="15" />
                        </t:rowMode>
