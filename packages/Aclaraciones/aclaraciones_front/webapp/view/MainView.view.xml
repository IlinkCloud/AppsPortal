<mvc:View
    controllerName="aclaracionesfront.controller.MainView"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table"
    xmlns:rowmodes="sap.ui.table.rowmodes"
>
    <App>
        <pages>
            <Page
                title="{i18n>clarifications.title}"
                showNavButton="false"
                showSubHeader="false"
                navButtonPress="onNavBack"
            >
                <content>
                    <t:Table
                        id="idTableAcla"
                        rows="{obtenAcla>/results}"
                        selectionMode="Single"
                        selectionBehavior="RowSelector"
                        alternateRowColors="true"
                        enableColumnReordering="true"
                        enableBusyIndicator="true"
                        enableSelectAll="false"
                        noData="{i18n>clarifications.without}"
                        rowSelectionChange="onRowSelectionChangeAcla"
                    >
                        <t:rowMode>
                            <rowmodes:Interactive rowCount="15" />
                        </t:rowMode>
                        <t:columns>
                            <t:Column
                                width="7rem"
                                label="{i18n>clarifications.id}"
                                sortProperty="Id"
                                filterProperty="Id"
                            >
                                <t:template>
                                    <Text text="{obtenAcla>Id}" />
                                </t:template>
                            </t:Column>

                            <t:Column
                                width="6rem"
                                label="{i18n>clarifications.supplier}"
                                sortProperty="Supplier"
                                filterProperty="Supplier"
                            >
                                <t:template>
                                    <Text text="{obtenAcla>Supplier}" />
                                </t:template>
                            </t:Column>

                            <t:Column
                                width="10rem"
                                label="{i18n>clarifications.numDoc}"
                                sortProperty="Documents"
                                filterProperty="Documents"
                            >
                                <t:template>
                                    <Text
                                        text="{obtenAcla>DocumentNumber}"
                                        wrapping="false"
                                    />
                                </t:template>
                            </t:Column>

                            <t:Column
                                width="10rem"
                                label="{i18n>clarifications.typeDoc}"
                                sortProperty="DocumentType"
                                filterProperty="DocumentType"
                            >
                                <t:template>
                                    <Text
                                        text="{
                                            path: 'obtenAcla>DocumentType',
                                            formatter: '.formatDocumentType'
                                        }"
                                    />
                                </t:template>
                            </t:Column>

                            <t:Column
                                width="30rem"
                                label="{i18n>clarifications.textBrief}"
                                sortProperty="Message"
                                filterProperty="Message"
                            >
                                <t:template>
                                    <Text
                                        text="{obtenAcla>Message}"
                                        maxLines="1"
                                        wrapping="false"
                                    />
                                </t:template>
                            </t:Column>

                            <t:Column
                                width="10rem"
                                label="{i18n>clarifications.date}"
                                sortProperty="Date"
                                filterProperty="Date"
                            >
                                <t:template>
                                    <Text
                                        text="{
                                            path: 'obtenAcla>CreationDate',
                                            formatter: '.formatLocalDate'
                                        }"
                                    />
                                </t:template>
                            </t:Column>

                            <t:Column
                                width="6rem"
                                label="{i18n>clarifications.status}"
                                sortProperty="Status"
                                filterProperty="Status"
                            >
                                <t:template>
                                    <ObjectStatus
                                        text="{
                                            path: 'obtenAcla>Status',
                                            formatter: '.formatStatusText'
                                        }"
                                        state="{
                                            path: 'obtenAcla>Status',
                                            formatter: '.formatStatusState'
                                        }"
                                    />
                                </t:template>
                            </t:Column>
                        </t:columns>
                    </t:Table>
                </content>
            </Page>
        </pages>
    </App>
</mvc:View>
