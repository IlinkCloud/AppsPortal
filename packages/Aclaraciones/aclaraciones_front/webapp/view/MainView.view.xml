                        <t:columns>
                            <t:Column
                                width="8rem"
                                label="{i18n>clarifications.id}"
                                sortProperty="Id"
                                filterProperty="Id"
                            >
                                <t:template>
                                    <Text text="{obtenAcla>Id}" />
                                </t:template>
                            </t:Column>

                            <t:Column
                                width="8rem"
                                label="{i18n>clarifications.supplier}"
                                sortProperty="Supplier"
                                filterProperty="Supplier"
                            >
                                <t:template>
                                    <Text text="{obtenAcla>Supplier}" />
                                </t:template>
                            </t:Column>

                            <t:Column
                                width="10rem"
                                label="{i18n>clarifications.numDoc}"
                                sortProperty="Documents"
                                filterProperty="Documents"
                            >
                                <t:template>
                                    <Text
                                        text="{obtenAcla>DocumentNumber}"
                                        wrapping="false"
                                    />
                                </t:template>
                            </t:Column>

                            <t:Column
                                width="10rem"
                                label="{i18n>clarifications.typeDoc}"
                                sortProperty="DocumentType"
                                filterProperty="DocumentType"
                            >
                                <t:template>
                                    <Text text="{obtenAcla>DocumentType}" />
                                </t:template>
                            </t:Column>

                            <t:Column
                                width="30rem"
                                label="{i18n>clarifications.textBrief}"
                                sortProperty="Message"
                                filterProperty="Message"
                            >
                                <t:template>
                                    <Text
                                        text="{obtenAcla>Message}"
                                        maxLines="1"
                                        wrapping="false"
                                    />
                                </t:template>
                            </t:Column>

                            <t:Column
                                width="10rem"
                                label="{i18n>clarifications.date}"
                                sortProperty="Date"
                                filterProperty="Date"
                            >
                                <t:template>
                                    <Text
                                        text="{
                                            path: 'obtenAcla>CreationDate',
                                            formatter: '.formatDate'
                                        }"
                                    />
                                </t:template>
                            </t:Column>

                            <t:Column
                                width="10rem"
                                label="{i18n>clarifications.status}"
                                sortProperty="Status"
                                filterProperty="Status"
                            >
                                <t:template>
                                    <Text text="{obtenAcla>Status}" />
                                </t:template>
                            </t:Column>
                        </t:columns>
                    </t:Table>
