_schema-version: "3.2"
ID: EnviarCfdiPagoDev-extension
extends: EnviarCfdiPago

parameters:
  appname: enviarcfdipago-dev
  subdomain: ${org}

modules:
  - name: enviarcfdipago-approuter
    parameters:
      memory: 256M
      disk-quota: 256M
      routes:
        - route: https://${subdomain}-${appname}.${default-domain}

resources:
  - name: uaa_EnviarCfdiPago
    parameters:
      service-name: ${appname}-xsuaa
      config:
        xsappname: ${appname}

  - name: EnviarCfdiPago_saas_registry
    parameters:
      service-name: ${appname}-saas-registry
      config:
        xsappname: ${appname}
        appName: ${appname}
        displayName: Enviar Cfdi Pago Dev
        description: Aplicacion Enviar Cfdi Pago - Ambiente Dev

  - name: AppsPortalFront-destination-service
    parameters:
      service-name: AppsPortalFront-dev-destination

  - name: EnviarCfdiPago_html_repo_host
    parameters:
      service-name: EnviarCfdiPago-Dev-html5-host

  - name: AppsPortalFront_html_repo_runtime
    parameters:
      service-name: AppsPortalFront-dev-html5-runtime
