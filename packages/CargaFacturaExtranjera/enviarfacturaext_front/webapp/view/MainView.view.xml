<mvc:View
    controllerName="enviarfacturaextfront.controller.MainView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>
    <Page
        showHeader="true"
        title="{i18n>title}"
        showFooter="false"
        showNavButton="false"
        class="sapUiContentPadding"
    >
        <headerContent>
            <FlexBox
                width="100%"
                alignItems="Start"
                justifyContent="SpaceBetween"
            >
                <items>
                    <Toolbar>
                        <ToolbarSpacer />
                        <Label text="{i18n>facturas.de}" />
                        <DatePicker
                            id="startDatePicker"
                            width="auto"
                            change="onChangeDate"
                            displayFormat="dd/MM/yyyy"
                            valueFormat="yyyy-MM-dd"
                            placeholder="dd/MM/yyyy"
                        />
                        <Label text="{i18n>facturas.hasta}" />
                        <DatePicker
                            id="endDatePicker"
                            width="auto"
                            change="onChangeDate"
                            displayFormat="dd/MM/yyyy"
                            valueFormat="yyyy-MM-dd"
                            placeholder="dd/MM/yyyy"
                        />
                    </Toolbar>
                </items>
            </FlexBox>
        </headerContent>

        <content>
            <Table
                id="docMatList"
                items="{path: 'documents>/results'}"
                mode="MultiSelect"
                growing="true"
                selectionChange="onTableSelectionChange"
            >
                <headerToolbar>
                    <Toolbar>
                        <content>
                            <Title text="{i18n>facturas.entradas}" />
                            <ToolbarSpacer />
                            <SearchField
                                id="searchField"
                                width="20%"
                                placeholder="{i18n>facturas.buscar}"
                                liveChange="onSearch"
                                search="onSearch"
                            />
                            <Button
                                icon="sap-icon://upload"
                                text="{i18n>facturas.cargarFactura}"
                                type="Emphasized"
                                press="uploadButton"
                            />
                            <Button
                                icon="sap-icon://discussion"
                                text="{i18n>facturas.enviarAclaracion}"
                                type="Emphasized"
                                press="aclaracionButton"
                            />
                        </content>
                    </Toolbar>
                </headerToolbar>

                <columns>
                    <Column>
                        <Text text="{i18n>facturas.numEntrega}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>facturas.ordenCompra}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>facturas.itemPedido}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>facturas.posicionMaterial}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>facturas.nombreProveedor}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>facturas.cliente}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>facturas.referencia}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>facturas.claseCondicion}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>facturas.fechaDocumento}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>facturas.importePedido}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>facturas.importeEM}" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem
                        highlight="{= ${documents>isBlockedForSelection} ? 'Error' : 'None' }"
                        type="{= ${documents>isBlockedForSelection} ? 'Inactive' : 'Active' }"
                    >
                        <cells>
                            <Text text="{documents>DeliveryNumber}" />
                            <Text text="{documents>PurchaseOrder}" />
                            <Text text="{documents>PurchaseOrderItem}" />
                            <Text text="{documents>MaterialItem}" />
                            <Text text="{documents>SupplierName}" />
                            <Text text="{documents>Customer}" />
                            <Text text="{documents>Reference}" />
                            <Text text="{documents>ConditionType}" />
                            <Text
                                text="{path: 'documents>DocumentDate', type:'sap.ui.model.type.Date', formatOptions:{style:'medium'}}"
                            />
                            <ObjectNumber
                                number="{documents>PurchaseOrderAmount}"
                                unit="{documents>DocumentCurrency}"
                            />
                            <ObjectNumber
                                number="{documents>GoodsReceiptAmount}"
                                unit="{documents>DocumentCurrency}"
                            />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>















            <Dialog
                id="dlgAclaracion"
                title="Carga de Anexos para Aclaración"
                stretchOnPhone="true"
                contentWidth="40rem"
                xmlns:core="sap.ui.core"
            >
                <content>
                    <VBox
                        id="_IDGenVBox1"
                        class="sapUiSmallMargin"
                    >
                        <Title
                            id="_IDGenTitle"
                            text="Anexos (0)"
                            level="H3"
                        />
                        <HBox
                            id="_IDGenHBox"
                            alignItems="Center"
                            justifyContent="SpaceBetween"
                        >
                            <Text
                                id="_IDGenText9"
                                text="Ningún archivo ha sido cargado"
                            />
                            <Button
                                id="_IDGenButton"
                                text="Añadir"
                                type="Transparent"
                            />
                        </HBox>
                        <Text
                            id="_IDGenText10"
                            text="Máximo 5 archivos / 10 Mb. Formatos válidos: PDF, PNG y JPG."
                        />

                        <Label
                            id="_IDGenLabel6"
                            text="Comentario"
                        />
                        <TextArea
                            id="_IDGenTextArea1"
                            width="100%"
                            placeholder="Ingrese un comentario descriptivo a la aclaración."
                            rows="4"
                        />
                    </VBox>
                </content>

                <beginButton>
                    <Button
                        id="_IDGenButton3"
                        text="Enviar"
                        type="Emphasized"
                        press=".onEnviarAclaracionConfirm"
                    />
                </beginButton>
                <endButton>
                    <Button
                        id="_IDGenButton4"
                        text="Cerrar"
                        press=".onCerrarAclaracion"
                    />
                </endButton>
            </Dialog>



        </content>
    </Page>
</mvc:View>
