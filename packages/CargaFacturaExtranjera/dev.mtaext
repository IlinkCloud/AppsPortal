_schema-version: "3.2"
ID: EnviarFacturaExtDev-extension
extends: EnviarFacturaExt

parameters:
  appname: enviarfacturaext-dev
  subdomain: ${org}

modules:
  - name: enviarfacturaext-approuter
    parameters:
      memory: 256M
      disk-quota: 256M
      routes:
        - route: https://${subdomain}-${appname}.${default-domain}

resources:

  - name: uaa_EnviarFacturaExt
    parameters:
      service-name: ${appname}-xsuaa
      config:
        xsappname: ${appname}

  - name: EnviarFacturaExt_saas_registry
    parameters:
      service-name: ${appname}-saas-registry
      config:
        xsappname: ${appname}
        appName: ${appname}
        displayName: Factura Extranjera Dev
        description: Aplicación Factura Extranjera - Ambiente Dev

  - name: AppsPortalFront-destination-service
    parameters:
      service-name: AppsPortalFront-dev-destination

  - name: EnviarFacturaExt_html_repo_host
    parameters:
      service-name: EnviarFacturaExt-Dev-html5-host

  - name: AppsPortalFront_html_repo_runtime
    parameters:
      service-name: AppsPortalFront-dev-html5-runtime