_schema-version: "3.2"
ID: EnviarFacturasTest-extension
extends: EnviarFacturas

parameters:
  appname: enviarfacturas-test
  subdomain: ${org}

modules:
  - name: enviarfacturas-approuter
    parameters:
      memory: 256M
      disk-quota: 256M
      routes:
        - route: https://${subdomain}-${appname}.${default-domain}

resources:

  - name: uaa_EnviarFacturas
    parameters:
      service-name: ${appname}-xsuaa
      config:
        xsappname: ${appname}

  - name: EnviarFacturas_saas_registry
    parameters:
      service-name: ${appname}-saas-registry
      config:
        xsappname: ${appname}
        appName: ${appname}
        displayName: Enviar Facturas Test
        description: Aplicacion Enviar Facturas - Ambiente Test

  - name: AppsPortalFront-destination-service
    parameters:
      service-name: AppsPortalFront-test-destination

  - name: EnviarFacturas_html_repo_host
    parameters:
      service-name: EnviarFacturas-Test-html5-host

  - name: AppsPortalFront_html_repo_runtime
    parameters:
      service-name: AppsPortalFront-test-html5-runtime