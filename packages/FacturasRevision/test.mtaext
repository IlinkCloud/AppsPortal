_schema-version: "3.2"
ID: FacturasEnRevisionTest-extension
extends: FacturasEnRevision

parameters:
  appname: facturasenrevision-test
  subdomain: ${org}

modules:
  - name: facturasenrevision-approuter
    parameters:
      memory: 256M
      disk-quota: 256M
      routes:
        - route: https://${subdomain}-${appname}.${default-domain}

resources:

  - name: uaa_FacturasEnRevision
    parameters:
      service-name: ${appname}-xsuaa
      config:
        xsappname: ${appname}

  - name: FacturasEnRevision_saas_registry
    parameters:
      service-name: ${appname}-saas-registry
      config:
        xsappname: ${appname}
        appName: ${appname}
        displayName: Facturas en Revision Test
        description: Aplicacion Facturas en Revision - Ambiente Test

  - name: AppsPortalFront-destination-service
    parameters:
      service-name: AppsPortalFront-test-destination

  - name: FacturasEnRevision_html_repo_host
    parameters:
      service-name: FacturasEnRevision-Test-html5-host

  - name: AppsPortalFront_html_repo_runtime
    parameters:
      service-name: AppsPortalFront-test-html5-runtime