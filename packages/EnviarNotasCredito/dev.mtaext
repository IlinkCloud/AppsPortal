_schema-version: "3.2"
ID: EnviarNotaCreditoDev-extension
extends: EnviarNotaCredito

parameters:
  appname: enviarnotacredito-dev
  subdomain: ${org}

modules:
  - name: enviarnotacredito-approuter
    parameters:
      memory: 256M
      disk-quota: 256M
      routes:
        - route: https://${subdomain}-${appname}.${default-domain}

resources:

  - name: uaa_EnviarNotaCredito
    parameters:
      service-name: ${appname}-xsuaa
      config:
        xsappname: ${appname}

  - name: EnviarNotaCredito_saas_registry
    parameters:
      service-name: ${appname}-saas-registry
      config:
        xsappname: ${appname}
        appName: ${appname}
        displayName: Enviar Nota de Credito Dev
        description: Aplicacion Enviar Nota de Credito - Ambiente Dev

  - name: AppsPortalFront-destination-service
    parameters:
      service-name: AppsPortalFront-dev-destination

  - name: EnviarNotaCredito_html_repo_host
    parameters:
      service-name: EnviarNotaCredito-Dev-html5-host

  - name: AppsPortalFront_html_repo_runtime
    parameters:
      service-name: AppsPortalFront-dev-html5-runtime