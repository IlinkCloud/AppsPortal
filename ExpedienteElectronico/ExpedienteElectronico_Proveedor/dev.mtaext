_schema-version: "3.2"
ID: ExpedienteElectronico_ProveedorDev-extension
extends: ExpedienteElectronico_Proveedor

parameters:
  appname: expedienteelectronico-proveedor-dev
  subdomain: ${org}

modules:
  - name: expedienteelectronico-proveedor-approuter
    parameters:
      memory: 256M
      disk-quota: 256M
      routes:
        - route: https://${subdomain}-${appname}.${default-domain}

resources:

  - name: uaa_ExpedienteElectronico_Proveedor
    parameters:
      service-name: ${appname}-xsuaa
      config:
        xsappname: ${appname}

  - name: ExpedienteElectronico_Proveedor_saas_registry
    parameters:
      service-name: ${appname}-saas-registry
      config:
        xsappname: ${appname}
        appName: ${appname}
        displayName: Expediente Electronico Proveedor Dev
        description: Aplicación Expediente Electronico Proveedor - Ambiente Dev

  - name: AppsPortalFront-destination-service
    parameters:
      service-name: AppsPortalFront-dev-destination

  - name: ExpedienteElectronico_Proveedor_html_repo_host
    parameters:
      service-name: ExpedienteElectronico_Proveedor-Dev-html5-host

  - name: AppsPortalFront_html_repo_runtime
    parameters:
      service-name: AppsPortalFront-dev-html5-runtime